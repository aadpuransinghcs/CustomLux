<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Curve Editor Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_brightness_curve"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <!-- Curve Editor -->
        <FrameLayout
            android:id="@+id/graph_container"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginVertical="16dp"
            android:background="@color/bg_accent">

            <ImageView
                android:id="@+id/curve_drawing_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_curve_editor"
                android:scaleType="fitXY"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Curve Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_curve_settings"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:paddingTop="10dp"/>

        <!-- Min Brightness -->
        <TextView
            android:id="@+id/label_min_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_min_brightness"
            android:textColor="@color/text_main" />

        <SeekBar
            android:id="@+id/seek_min_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="10" />

        <!-- Max Brightness -->
        <TextView
            android:id="@+id/label_max_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_max_brightness"
            android:textColor="@color/text_main" />
        <SeekBar
            android:id="@+id/seek_max_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <!-- Movable Points -->
        <TextView
            android:id="@+id/label_point_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_movable_points"
            android:textColor="@color/text_main" />
        <SeekBar
            android:id="@+id/seek_point_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4" />

        <!-- Save Curve Button -->
        <Button
            android:id="@+id/btn_save_curve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#6200EE"
            android:textColor="@android:color/white"
            android:text="@string/btn_save_curve" />

    </LinearLayout>
</ScrollView>
