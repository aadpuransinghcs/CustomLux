<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Advanced Settings Page Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_advanced_settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Smart White-Level Compensation -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_white_level_comp"
            android:textSize="16sp"
            android:layout_toStartOf="@id/switch_white_level"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_white_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Description of: Smart White-Level Compensation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/desc_white_level_comp"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"
        android:alpha="0.7" />

    <!-- HBM Handover -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_hbm_handover"
            android:textSize="16sp"
            android:layout_toStartOf="@id/switch_hbm"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_hbm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Description of: HBM Handover -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/desc_hbm_handover"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"
        android:alpha="0.7" />

    <!-- Disable Curve Editor -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_disable_curve"
            android:textSize="16sp"
            android:layout_toStartOf="@id/switch_disable_curve"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_disable_curve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Description of: Disable Curve Editor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/desc_disable_curve"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"
        android:alpha="0.7" />

    <!-- Advanced Settings Close Button -->
    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_close"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
